# API Backend (copilo_taxi)
# URL du backend FastAPI pour les webhooks OAuth et API
API_URL=http://localhost:8000

# Google OAuth (Client ID public - pas sensible)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Next.js public variables (préfixées NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=https://api.copilo.tech